<Window x:Class="mewu_ai_Assistant.Views.MewuColorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="选择标注颜色" Width="410" Height="520" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="False" Background="#F9FBFE" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 FontFamily="Microsoft YaHei UI" Foreground="#334259">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Width" Value="58"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Background" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="#D9E2EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#687AF0"/><Setter TargetName="Box" Property="Background" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ColorSelector" TargetType="Border"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="CornerRadius" Value="7"/><Setter Property="BorderBrush" Value="White"/><Setter Property="BorderThickness" Value="2"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style x:Key="ColorButton" TargetType="Button">
   <Setter Property="MinWidth" Value="94"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="8,0,0,0"/>
   <Setter Property="Foreground" Value="#4A5A72"/><Setter Property="Background" Value="#F0F4F9"/><Setter Property="BorderBrush" Value="#D9E2EE"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ColorPrimaryButton" TargetType="Button" BasedOn="{StaticResource ColorButton}"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#6173ED"/><Setter Property="BorderBrush" Value="#6173ED"/></Style>
 </Window.Resources>
 <Border Background="#F9FBFE" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="16">
  <Grid Margin="20,0,20,18"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="284"/><RowDefinition Height="48"/><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="-4,0,-10,0" MouseLeftButtonDown="TitleMouseDown"><TextBlock Text="{Binding Title,RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/><Button Content="×" Style="{StaticResource ColorButton}" Width="32" MinWidth="32" Height="32" Margin="0" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="20" Foreground="#75839A" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CancelClick"/></Grid>
   <Grid x:Name="PalettePanel" Grid.Row="1" Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Image x:Name="HueRing" Focusable="True" Cursor="Cross" ToolTip="外环选择颜色" AutomationProperties.Name="色相环" MouseLeftButtonDown="HueMouseDown" MouseMove="HueMouseMove" MouseLeftButtonUp="PaletteMouseUp" KeyDown="HueKeyDown"/>
    <Grid x:Name="SaturationValuePlane" Width="156" Height="156" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="True" Cursor="Cross" ToolTip="色板调整深浅" AutomationProperties.Name="颜色深浅色板" MouseLeftButtonDown="PlaneMouseDown" MouseMove="PlaneMouseMove" MouseLeftButtonUp="PaletteMouseUp" KeyDown="PlaneKeyDown">
     <Border x:Name="HueBase" Background="Red"/>
     <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background></Border>
    </Grid>
    <Canvas IsHitTestVisible="False">
     <Border x:Name="HueSelector" Style="{StaticResource ColorSelector}"><Border BorderBrush="#28344A" BorderThickness="1" CornerRadius="5"/></Border>
     <Border x:Name="SaturationValueSelector" Style="{StaticResource ColorSelector}"><Border BorderBrush="#28344A" BorderThickness="1" CornerRadius="5"/></Border>
    </Canvas>
   </Grid>
   <Grid Grid.Row="2" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
    <Border x:Name="ColorPreview" Width="40" Height="34" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#D9E2EE" BorderThickness="1"/>
    <TextBlock Grid.Column="1" Text="HEX" VerticalAlignment="Center" Margin="8,0" Foreground="#75839A" FontSize="12"/>
    <TextBox x:Name="HexValue" Grid.Column="2" Width="116" MaxLength="7" TextChanged="HexTextChanged" AutomationProperties.Name="十六进制颜色"/>
   </Grid>
   <Grid Grid.Row="3" Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="24"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><TextBlock Text="R" Width="24" Foreground="#D94B58" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="RedValue" Width="78" MaxLength="3" TextChanged="ValueTextChanged" AutomationProperties.Name="红色通道"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="G" Width="24" Foreground="#2E9B6F" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="GreenValue" Width="78" MaxLength="3" TextChanged="ValueTextChanged" AutomationProperties.Name="绿色通道"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="B" Width="24" Foreground="#397FE3" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="BlueValue" Width="78" MaxLength="3" TextChanged="ValueTextChanged" AutomationProperties.Name="蓝色通道"/></StackPanel>
    <TextBlock x:Name="InputHint" Grid.Row="1" Grid.ColumnSpan="3" Foreground="#C7505B" FontSize="11" VerticalAlignment="Center"/>
   </Grid>
   <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button x:Name="CancelButton" Content="取消" IsCancel="True" Style="{StaticResource ColorButton}" Click="CancelClick"/><Button x:Name="ConfirmButton" Content="使用此颜色" IsDefault="True" Style="{StaticResource ColorPrimaryButton}" Click="ConfirmClick"/></StackPanel>
  </Grid>
 </Border>
</Window>
